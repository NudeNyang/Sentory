{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sentory Tauri Preview",
  "version": "1.6.0",
  "identifier": "com.sentory.preview",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sentory",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/Sentory/**"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../Sentory.App/Assets/Sentory.ico"
    ],
    "externalBin": [
      "binaries/sentory-engine"
    ]
  }
}
