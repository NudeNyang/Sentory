<Window x:Class="Sentory.App.SentoryDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sentory"
        Width="430"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E9E4DC" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F3EC" />
        <SolidColorBrush x:Key="TextBrush" Color="#292722" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6D6861" />
        <SolidColorBrush x:Key="LineBrush" Color="#CEC7BC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#756655" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#F7F4EE" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B85A52" />
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="26,24,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <TextBlock x:Name="DialogIcon"
                           Text="&#xE7BA;"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="15"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                <TextBlock x:Name="HeadingText"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="MessageText"
                           Margin="0,8,0,0"
                           FontSize="12"
                           LineHeight="19"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Height="1" Margin="0,22,0,18"
                Background="{DynamicResource LineBrush}" />
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="CancelButton"
                    Content="{DynamicResource Loc.Cancel}"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource TextBrush}"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="CancelButton_Click" />
            <Button x:Name="ConfirmButton"
                    Margin="8,0,0,0"
                    Foreground="{DynamicResource AccentTextBrush}"
                    Style="{StaticResource DialogButtonStyle}"
                    IsDefault="True"
                    Click="ConfirmButton_Click" />
        </StackPanel>
    </Grid>
</Window>
