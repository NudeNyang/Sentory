<Window x:Class="Sentory.App.ItemDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sentory 항목 상세"
        Width="790"
        Height="610"
        MinWidth="700"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E9E4DC" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F3EC" />
        <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#DED8CF" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#E4DED5" />
        <SolidColorBrush x:Key="TextBrush" Color="#292722" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6D6861" />
        <SolidColorBrush x:Key="SoftTextBrush" Color="#89827A" />
        <SolidColorBrush x:Key="LineBrush" Color="#CEC7BC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#756655" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#F7F4EE" />
        <SolidColorBrush x:Key="FavoriteBrush" Color="#B1842F" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B85A52" />

        <Style x:Key="DetailButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource InputBackgroundBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryDetailButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DetailButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TypeText"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="FavoriteText"
                               Margin="9,0,0,0"
                               Text="★ 즐겨찾기"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource FavoriteBrush}"
                               Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="TitleText"
                           Margin="0,7,0,0"
                           MaxWidth="650"
                           FontSize="23"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Content="닫기"
                    Style="{StaticResource DetailButtonStyle}"
                    Click="CloseButton_Click" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,22,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SurfaceSecondaryBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid>
                    <StackPanel x:Name="ArtworkFallback"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="76"
                                Height="76"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="20">
                            <TextBlock x:Name="InitialText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <TextBlock x:Name="DomainText"
                                   Margin="0,14,0,0"
                                   MaxWidth="260"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Image x:Name="ArtworkImage"
                           Margin="12"
                           Stretch="Uniform"
                           Visibility="Collapsed" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="DescriptionText"
                               FontSize="13"
                               LineHeight="20"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />

                    <Border x:Name="OriginalBorder"
                            Margin="0,18,0,0"
                            Padding="13,11"
                            Background="{DynamicResource InputBackgroundBrush}"
                            CornerRadius="10">
                        <TextBlock x:Name="OriginalText"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <UniformGrid Margin="0,18,0,0" Columns="2">
                        <Border Margin="0,0,5,5"
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="저장 횟수"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource SoftTextBrush}" />
                                <TextBlock x:Name="CaptureCountText"
                                           Margin="0,4,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="5,0,0,5"
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="복사 횟수"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource SoftTextBrush}" />
                                <TextBlock x:Name="CopyCountText"
                                           Margin="0,4,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,5,5,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="마지막 출처"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource SoftTextBrush}" />
                                <TextBlock x:Name="SourceText"
                                           Margin="0,4,0,0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="5,5,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="마지막 저장"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource SoftTextBrush}" />
                                <TextBlock x:Name="SavedAtText"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock x:Name="DeliveryText"
                               Margin="0,18,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource SoftTextBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2">
            <Button Content="삭제"
                    HorizontalAlignment="Left"
                    Foreground="{DynamicResource DangerBrush}"
                    Style="{StaticResource DetailButtonStyle}"
                    Click="DeleteButton_Click" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="OpenButton"
                        Margin="0,0,7,0"
                        Content="원본 열기"
                        Style="{StaticResource DetailButtonStyle}"
                        Click="OpenButton_Click" />
                <Button x:Name="CopyButton"
                        Content="클립보드에 복사"
                        Style="{StaticResource PrimaryDetailButtonStyle}"
                        Click="CopyButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
