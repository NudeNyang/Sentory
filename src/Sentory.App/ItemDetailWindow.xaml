<Window x:Class="Sentory.App.ItemDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sentory.App"
        Title="{DynamicResource Loc.DetailTitle}"
        Width="790"
        Height="610"
        MinWidth="700"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E9E4DC" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F3EC" />
        <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#DED8CF" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#E4DED5" />
        <SolidColorBrush x:Key="TextBrush" Color="#292722" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6D6861" />
        <SolidColorBrush x:Key="SoftTextBrush" Color="#89827A" />
        <SolidColorBrush x:Key="LineBrush" Color="#CEC7BC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#756655" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#F7F4EE" />
        <SolidColorBrush x:Key="FavoriteBrush" Color="#B1842F" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B85A52" />

        <Style x:Key="DetailButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource InputBackgroundBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryDetailButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource DetailButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style x:Key="SelectableDetailTextStyle"
               TargetType="{x:Type local:SelectableTextBlock}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Cursor" Value="IBeam" />
        </Style>
    </Window.Resources>

    <Viewbox Margin="28,24,28,24"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             Stretch="Uniform">
    <Grid Width="734" Height="523">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <local:SelectableTextBlock x:Name="TypeText"
                             FontSize="11"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource AccentBrush}"
                             Style="{StaticResource SelectableDetailTextStyle}" />
                    <TextBlock x:Name="FavoriteText"
                               Margin="9,0,0,0"
                               Text="{DynamicResource Loc.FavoriteMarked}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource FavoriteBrush}"
                               Visibility="Collapsed" />
                </StackPanel>
                <local:SelectableTextBlock x:Name="TitleText"
                         Margin="0,7,0,0"
                         MaxWidth="734"
                         MaxHeight="66"
                         FontSize="23"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextBrush}"
                         TextWrapping="Wrap"
                         Style="{StaticResource SelectableDetailTextStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,22,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ArtworkSurface"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    ClipToBounds="True"
                    Cursor="Hand"
                    Focusable="True"
                    FocusVisualStyle="{x:Null}"
                    MouseLeftButtonUp="ArtworkSurface_MouseLeftButtonUp"
                    KeyDown="ArtworkSurface_KeyDown">
                <Grid>
                    <StackPanel x:Name="ArtworkFallback"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Width="76"
                                Height="76"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="20">
                            <TextBlock x:Name="InitialText"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <local:SelectableTextBlock x:Name="DomainText"
                                 Margin="0,14,0,0"
                                 MaxWidth="260"
                                 HorizontalAlignment="Center"
                                 FontSize="13"
                                 Foreground="{DynamicResource MutedTextBrush}"
                                 Style="{StaticResource SelectableDetailTextStyle}" />
                    </StackPanel>

                    <Border x:Name="StackBackTwo"
                            Margin="34,28,22,66"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Opacity="0.28"
                            RenderTransformOrigin="0.5,0.5"
                            Visibility="Collapsed">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="-3" />
                                <TranslateTransform X="-3" Y="2" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Background>
                            <ImageBrush x:Name="StackBackTwoBrush"
                                        Stretch="Uniform"
                                        AlignmentX="Center"
                                        AlignmentY="Center" />
                        </Border.Background>
                    </Border>
                    <Border x:Name="StackBackOne"
                            Margin="24,24,32,62"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Opacity="0.5"
                            RenderTransformOrigin="0.5,0.5"
                            Visibility="Collapsed">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="2.4" />
                                <TranslateTransform X="4" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Background>
                            <ImageBrush x:Name="StackBackOneBrush"
                                        Stretch="Uniform"
                                        AlignmentX="Center"
                                        AlignmentY="Center" />
                        </Border.Background>
                    </Border>
                    <Border x:Name="ArtworkImage"
                            Margin="12"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="0"
                            CornerRadius="10"
                            Visibility="Collapsed">
                        <Border.Background>
                            <ImageBrush x:Name="ArtworkImageBrush"
                                        Stretch="Uniform"
                                        AlignmentX="Center"
                                        AlignmentY="Center" />
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="DetailScrollSurface" Grid.Column="2">
                <ScrollViewer x:Name="DetailScrollViewer"
                              Padding="0,0,12,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              FocusVisualStyle="{x:Null}">
                    <StackPanel>
                    <local:SelectableTextBlock x:Name="DescriptionText"
                             Padding="10,4,0,4"
                             FontSize="13"
                             LineHeight="20"
                             Foreground="{DynamicResource MutedTextBrush}"
                             TextWrapping="Wrap"
                             Style="{StaticResource SelectableDetailTextStyle}" />

                    <StackPanel x:Name="PhotoControlsSection"
                                Margin="10,18,0,0"
                                Visibility="Collapsed">
                        <TextBlock Margin="2,0,0,8"
                                   Text="{DynamicResource Loc.Photos}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <Border Padding="11,7,7,7"
                                Background="{DynamicResource InputBackgroundBrush}"
                                CornerRadius="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <local:SelectableTextBlock x:Name="CurrentPhotoNameText"
                                         VerticalAlignment="Center"
                                         FontSize="11"
                                         Foreground="{DynamicResource TextBrush}"
                                         Style="{StaticResource SelectableDetailTextStyle}" />
                                <Button x:Name="CurrentPhotoCopyButton"
                                        Grid.Column="1"
                                        Width="31"
                                        Height="31"
                                        Padding="0"
                                        ToolTip="{DynamicResource Loc.CopyCurrentPhoto}"
                                        Style="{StaticResource DetailButtonStyle}"
                                        Click="CopyCurrentPhotoButton_Click">
                                    <TextBlock x:Name="CurrentPhotoCopyIcon"
                                               Text="&#xE8C8;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="13" />
                                </Button>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="PhotoNavigation"
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                            <Button x:Name="PreviousPhotoButton"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Content="&#x2039;"
                                    FontSize="19"
                                    Opacity="0.72"
                                    ToolTip="{DynamicResource Loc.PreviousPhoto}"
                                    Style="{StaticResource DetailButtonStyle}"
                                    Click="PreviousPhotoButton_Click" />
                            <StackPanel x:Name="PhotoPageDots"
                                        MinWidth="38"
                                        Margin="7,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal" />
                            <Button x:Name="NextPhotoButton"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Content="&#x203A;"
                                    FontSize="19"
                                    Opacity="0.72"
                                    ToolTip="{DynamicResource Loc.NextPhoto}"
                                    Style="{StaticResource DetailButtonStyle}"
                                    Click="NextPhotoButton_Click" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="CollectionLinksSection"
                                Margin="10,18,0,0"
                                Visibility="Collapsed">
                        <TextBlock Margin="2,0,0,8"
                                   Text="{DynamicResource Loc.CollectionLinks}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <ItemsControl x:Name="CollectionLinksList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,7"
                                            Padding="11,7,7,7"
                                            Background="{DynamicResource InputBackgroundBrush}"
                                            CornerRadius="9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <local:SelectableTextBlock Text="{Binding Url}"
                                                     VerticalAlignment="Center"
                                                     FontSize="11"
                                                     Foreground="{DynamicResource TextBrush}"
                                                     TextWrapping="Wrap"
                                                     Style="{StaticResource SelectableDetailTextStyle}" />
                                            <Button Grid.Column="1"
                                                    MinWidth="52"
                                                    Height="31"
                                                    Margin="8,0,0,0"
                                                    Padding="10,0"
                                                    Content="{DynamicResource Loc.Copy}"
                                                    Style="{StaticResource DetailButtonStyle}"
                                                    Tag="{Binding Url}"
                                                    Click="CopyCollectionLinkButton_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel x:Name="LinkNavigation"
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <Button x:Name="PreviousLinkButton"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Content="&#x2039;"
                                    FontSize="19"
                                    Opacity="0.72"
                                    ToolTip="{DynamicResource Loc.PreviousLink}"
                                    Style="{StaticResource DetailButtonStyle}"
                                    Click="PreviousLinkButton_Click" />
                            <StackPanel x:Name="LinkPageDots"
                                        MinWidth="38"
                                        Margin="7,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal" />
                            <Button x:Name="NextLinkButton"
                                    Width="28"
                                    Height="28"
                                    Padding="0"
                                    Content="&#x203A;"
                                    FontSize="19"
                                    Opacity="0.72"
                                    ToolTip="{DynamicResource Loc.NextLink}"
                                    Style="{StaticResource DetailButtonStyle}"
                                    Click="NextLinkButton_Click" />
                        </StackPanel>
                    </StackPanel>

                    <UniformGrid Margin="10,18,0,0" Columns="2">
                        <Border Margin="0,0,5,5"
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.CaptureCount}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource SoftTextBrush}" />
                                <local:SelectableTextBlock x:Name="CaptureCountText"
                                         Margin="0,4,0,0"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextBrush}"
                                         Style="{StaticResource SelectableDetailTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="5,0,0,5"
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.CopyCount}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource SoftTextBrush}" />
                                <local:SelectableTextBlock x:Name="CopyCountText"
                                         Margin="0,4,0,0"
                                         FontSize="14"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextBrush}"
                                         Style="{StaticResource SelectableDetailTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,5,5,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.LastSource}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource SoftTextBrush}" />
                                <local:SelectableTextBlock x:Name="SourceText"
                                         Margin="0,4,0,0"
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextBrush}"
                                         Style="{StaticResource SelectableDetailTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="5,5,0,0"
                                Padding="12"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Loc.LastSaved}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource SoftTextBrush}" />
                                <local:SelectableTextBlock x:Name="SavedAtText"
                                         Margin="0,4,0,0"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextBrush}"
                                         Style="{StaticResource SelectableDetailTextStyle}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <local:SelectableTextBlock x:Name="DeliveryText"
                             Margin="10,18,0,0"
                             FontSize="11"
                             Foreground="{DynamicResource SoftTextBrush}"
                             Style="{StaticResource SelectableDetailTextStyle}" />
                    </StackPanel>
                </ScrollViewer>

                <Border x:Name="DetailScrollIndicator"
                        Panel.ZIndex="40"
                        Width="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        Cursor="Arrow"
                        IsHitTestVisible="False"
                        Opacity="0"
                        SnapsToDevicePixels="True"
                        Visibility="Visible">
                    <Grid ClipToBounds="True">
                        <Border x:Name="DetailScrollIndicatorThumb"
                                Width="3"
                                Height="32"
                                Margin="0,0,3,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="3"
                                Opacity="0.46"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="DetailScrollIndicatorThumbTransform" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

    </Grid>
    </Viewbox>
</Window>
