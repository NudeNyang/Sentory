<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sentory.Core\Sentory.Core.csproj" />
    <ProjectReference Include="..\Sentory.Infrastructure\Sentory.Infrastructure.csproj" />
    <ProjectReference Include="..\Sentory.Platform.Windows\Sentory.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <AssemblyName>Sentory</AssemblyName>
    <RootNamespace>Sentory.App</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Version>1.6.0</Version>
    <AssemblyVersion>1.6.0.0</AssemblyVersion>
    <FileVersion>1.6.0.0</FileVersion>
    <SentoryBuildFlavor Condition="'$(SentoryBuildFlavor)' == ''">Developer</SentoryBuildFlavor>
    <InformationalVersion Condition="'$(SentoryBuildFlavor)' == 'Public'">1.6.0</InformationalVersion>
    <InformationalVersion Condition="'$(SentoryBuildFlavor)' == 'Developer'">1.6.0+developers</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>NudeNyang</Authors>
    <Company>NudeNyang</Company>
    <Product>Sentory</Product>
    <Description>이야기 속, 흩어진 순간들을 한 곳에</Description>
    <Copyright>Copyright © 2026 NudeNyang</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\Sentory.ico</ApplicationIcon>
  </PropertyGroup>

  <Target Name="ValidateSentoryBuildFlavor" BeforeTargets="BeforeBuild">
    <Error Condition="'$(SentoryBuildFlavor)' != 'Developer' and '$(SentoryBuildFlavor)' != 'Public'"
           Text="SentoryBuildFlavor must be Developer or Public." />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="GalleryWeb\index.html"
                      LogicalName="Sentory.GalleryWeb.index.html" />
    <EmbeddedResource Include="GalleryWeb\gallery.css"
                      LogicalName="Sentory.GalleryWeb.gallery.css" />
    <EmbeddedResource Include="GalleryWeb\gallery.js"
                      LogicalName="Sentory.GalleryWeb.gallery.js" />
    <EmbeddedResource Include="..\..\LICENSE.txt"
                      Link="Resources\LICENSE.txt"
                      LogicalName="Sentory.LICENSE.txt" />
    <EmbeddedResource Include="..\..\distribution\THIRD-PARTY-NOTICES.txt"
                      Link="Resources\THIRD-PARTY-NOTICES.txt"
                      LogicalName="Sentory.THIRD-PARTY-NOTICES.txt" />
    <EmbeddedResource Include="..\..\docs\model-provenance.md"
                      Link="Resources\MODEL-PROVENANCE.md"
                      LogicalName="Sentory.MODEL-PROVENANCE.md" />
  </ItemGroup>

</Project>
