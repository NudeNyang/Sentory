<Window x:Class="Sentory.App.DataManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sentory 데이터 관리"
        Width="520"
        Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E9E4DC" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F3EC" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#E4DED5" />
        <SolidColorBrush x:Key="TextBrush" Color="#292722" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6D6861" />
        <SolidColorBrush x:Key="LineBrush" Color="#CEC7BC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#756655" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#F7F4EE" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B85A52" />

        <Style TargetType="ComboBox">
            <Setter Property="Background"
                    Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="데이터 관리"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock Margin="0,5,0,0"
                       Text="즐겨찾기는 모든 정리 작업에서 항상 보존됩니다."
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,22,0,0"
                Padding="18"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="보관 중"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="TotalItemsText"
                               Margin="0,5,0,0"
                               Text="-"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="KindsText"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="사진 저장 용량"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="ImageBytesText"
                               Margin="0,5,0,0"
                               Text="-"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="FavoriteItemsText"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="18"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <StackPanel>
                <TextBlock Text="기간이 지난 항목 정리"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Margin="0,5,0,0"
                           Text="마지막으로 저장된 시점을 기준으로 정리합니다."
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ManualCleanupComboBox"
                              Height="38"
                              Padding="9,0"
                              DisplayMemberPath="Label"
                              VerticalContentAlignment="Center" />
                    <Button x:Name="ManualCleanupButton"
                            Grid.Column="2"
                            Content="지금 정리"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="ManualCleanupButton_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Padding="18"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <StackPanel>
                <TextBlock Text="자동 정리"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Margin="0,5,0,0"
                           Text="기본값은 사용 안 함이며, 90일을 권장합니다."
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="AutoCleanupComboBox"
                              Height="38"
                              Padding="9,0"
                              DisplayMemberPath="Label"
                              VerticalContentAlignment="Center" />
                    <Button x:Name="SaveAutoCleanupButton"
                            Grid.Column="2"
                            Content="설정 저장"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="SaveAutoCleanupButton_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button x:Name="DeleteNonFavoritesButton"
                    Height="40"
                    Content="즐겨찾기 제외 모두 삭제"
                    Background="{DynamicResource DangerBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontSize="12"
                    Click="DeleteNonFavoritesButton_Click" />
            <TextBlock x:Name="StatusText"
                       Grid.Row="1"
                       Margin="0,10,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </Grid>
    </Grid>
</Window>
