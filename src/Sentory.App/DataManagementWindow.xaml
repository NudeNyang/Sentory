<Window x:Class="Sentory.App.DataManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sentory 설정"
        Width="680"
        Height="760"
        MinWidth="620"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E9E4DC" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F3EC" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#E4DED5" />
        <SolidColorBrush x:Key="PopupBackgroundBrush" Color="#F7F3EC" />
        <SolidColorBrush x:Key="PopupHoverBrush" Color="#E4DED5" />
        <SolidColorBrush x:Key="TextBrush" Color="#292722" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6D6861" />
        <SolidColorBrush x:Key="SoftTextBrush" Color="#89827A" />
        <SolidColorBrush x:Key="LineBrush" Color="#CEC7BC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#756655" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#F7F4EE" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B85A52" />

        <Style x:Key="SettingCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MaxDropDownHeight" Value="220" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="12,9" />
                        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="{DynamicResource PopupHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder"
                                                    Property="Background"
                                                    Value="{DynamicResource PopupHoverBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <Border x:Name="ClosedBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <ContentPresenter Margin="12,0,38,0"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      IsHitTestVisible="False" />
                                    <TextBlock Margin="0,0,13,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="10"
                                               Foreground="{TemplateBinding Foreground}"
                                               Text="&#xE70D;" />
                                </Grid>
                            </Border>
                            <ToggleButton Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, ElementName=Root}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource PopupBackgroundBrush}"
                                        BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,20,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="설정"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock Margin="0,5,0,0"
                       Text="Sentory의 실행, 메신저 감지와 보관 데이터를 한곳에서 관리합니다"
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,22,0,18"
                      Padding="0,0,8,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="일반"
                           Margin="2,0,0,8"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="화면 테마"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="라이트 모드와 다크 모드를 선택합니다"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeComboBox"
                                      Width="150"
                                      HorizontalAlignment="Right"
                                      DisplayMemberPath="Label"
                                      SelectionChanged="ThemeComboBox_SelectionChanged" />
                        </Grid>
                        <Border Height="1"
                                Margin="0,16"
                                Background="{DynamicResource LineBrush}" />
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Windows 시작 시 실행"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock x:Name="StartupDescriptionText"
                                           Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <Button x:Name="StartupToggleButton"
                                    Width="92"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="StartupToggleButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="메신저 감지"
                           Margin="2,20,0,8"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Discord"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock x:Name="DiscordStatusText"
                                           Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button x:Name="DiscordRepairButton"
                                        Margin="0,0,7,0"
                                        Content="다시 연결"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="DiscordRepairButton_Click" />
                                <Button x:Name="DiscordSupportToggleButton"
                                        Width="92"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="DiscordSupportToggleButton_Click" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1"
                                Margin="0,16"
                                Background="{DynamicResource LineBrush}" />
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="카카오톡"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="채팅 입력창의 사진과 붙여넣은 링크를 감지합니다"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="감지 준비 완료"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="데이터 관리"
                           Margin="2,20,0,8"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Border Style="{StaticResource SettingCardStyle}">
                    <StackPanel>
                        <TextBlock Text="즐겨찾기에 등록된 항목은 자동 정리에서 포함되지 않음"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="보관 중"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource SoftTextBrush}" />
                                <TextBlock x:Name="TotalItemsText"
                                           Margin="0,4,0,0"
                                           Text="-"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock x:Name="KindsText"
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="사진 저장 용량"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource SoftTextBrush}" />
                                <TextBlock x:Name="ImageBytesText"
                                           Margin="0,4,0,0"
                                           Text="-"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" />
                                <TextBlock x:Name="FavoriteItemsText"
                                           Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1"
                                Margin="0,17"
                                Background="{DynamicResource LineBrush}" />
                        <TextBlock Text="자동 정리"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="기본값 사용 안 함"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AutoCleanupComboBox"
                                      DisplayMemberPath="Label" />
                            <Button x:Name="SaveAutoCleanupButton"
                                    Grid.Column="2"
                                    Content="설정 저장"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="SaveAutoCleanupButton_Click" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="OpenDataFolderButton"
                                    Content="데이터 폴더 열기"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OpenDataFolderButton_Click" />
                            <Button x:Name="DeleteNonFavoritesButton"
                                    Grid.Column="2"
                                    Content="즐겨찾기 제외 항목 모두 삭제"
                                    Background="{DynamicResource DangerBrush}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="DeleteNonFavoritesButton_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="앱 정보"
                           Margin="2,20,0,8"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Border Style="{StaticResource SettingCardStyle}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Sentory"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock x:Name="VersionText"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="저작자 © 2026 NudeNyang GitHub"
                                   FontSize="10">
                            <Run Text="© 2026" Foreground="{DynamicResource MutedTextBrush}" />
                            <Run Text=" · " Foreground="{DynamicResource LineBrush}" />
                            <Run Text="NudeNyang"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentBrush}" />
                            <Run Text=" · GitHub" Foreground="{DynamicResource MutedTextBrush}" />
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   MinHeight="18"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="11"
                   Foreground="{DynamicResource MutedTextBrush}" />
    </Grid>
</Window>
