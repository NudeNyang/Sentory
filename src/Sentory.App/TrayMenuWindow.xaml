<Window x:Class="Sentory.App.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sentory 빠른 설정"
        Width="286"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E9E4DC" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F3EC" />
        <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#E2DDD5" />
        <SolidColorBrush x:Key="TextBrush" Color="#292722" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6D6861" />
        <SolidColorBrush x:Key="SoftTextBrush" Color="#89827A" />
        <SolidColorBrush x:Key="LineBrush" Color="#CEC7BC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#756655" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B85A52" />
        <Style x:Key="TrayItemStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource StatusBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TrayIconStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="27" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Border Margin="10"
            Padding="10"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              Direction="270"
                              ShadowDepth="5"
                              Opacity="0.24"
                              Color="#45000000" />
        </Border.Effect>
        <StackPanel>
            <Grid Margin="8,6,8,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Sentory"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,3,0,0"
                               FontSize="10.5"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Width="8" Height="8"
                        Margin="8,2,2,0"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentBrush}"
                        CornerRadius="4" />
            </Grid>

            <Border Height="1" Margin="4,0,4,5"
                    Background="{DynamicResource LineBrush}" />

            <Button Style="{StaticResource TrayItemStyle}" Click="OpenGalleryButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8A7;" Style="{StaticResource TrayIconStyle}" />
                    <TextBlock Grid.Column="1" Text="보관함 열기" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="더블클릭"
                               FontSize="10" VerticalAlignment="Center"
                               Foreground="{DynamicResource SoftTextBrush}" />
                </Grid>
            </Button>

            <Button Style="{StaticResource TrayItemStyle}" Click="PauseButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PauseIcon" Style="{StaticResource TrayIconStyle}" />
                    <TextBlock x:Name="PauseText" Grid.Column="1" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Width="34" Height="19"
                            Background="{DynamicResource StatusBackgroundBrush}"
                            CornerRadius="10">
                        <Ellipse x:Name="PauseSwitchThumb" Width="13" Height="13"
                                 Margin="3" HorizontalAlignment="Left"
                                 Fill="{DynamicResource MutedTextBrush}" />
                    </Border>
                </Grid>
            </Button>

            <Button Style="{StaticResource TrayItemStyle}" Click="StartupButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7E8;" Style="{StaticResource TrayIconStyle}" />
                    <TextBlock Grid.Column="1" Text="Windows 자동 실행" VerticalAlignment="Center" />
                    <TextBlock x:Name="StartupCheck" Grid.Column="2"
                               FontFamily="Segoe Fluent Icons" FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}" />
                </Grid>
            </Button>

            <Button Style="{StaticResource TrayItemStyle}" Click="DiscordSupportButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE774;" Style="{StaticResource TrayIconStyle}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Discord 자동 연결" />
                        <TextBlock Text="접근성 모드로 시작"
                                   Margin="0,1,0,0" FontSize="9.5"
                                   Foreground="{DynamicResource SoftTextBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="DiscordSupportCheck" Grid.Column="2"
                               FontFamily="Segoe Fluent Icons" FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}" />
                </Grid>
            </Button>

            <Button x:Name="DiscordRepairButton"
                    Style="{StaticResource TrayItemStyle}"
                    Click="DiscordRepairButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE777;" Style="{StaticResource TrayIconStyle}" />
                    <TextBlock Grid.Column="1" Text="Discord 다시 연결" VerticalAlignment="Center" />
                </Grid>
            </Button>

            <Border Height="1" Margin="4,5"
                    Background="{DynamicResource LineBrush}" />

            <Button Style="{StaticResource TrayItemStyle}" Click="OpenDataButton_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource TrayIconStyle}" />
                    <TextBlock Grid.Column="1" Text="데이터 폴더 열기" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <Button Style="{StaticResource TrayItemStyle}" Click="ExitButton_Click"
                    Foreground="{DynamicResource DangerBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="27" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource TrayIconStyle}"
                               Foreground="{DynamicResource DangerBrush}" />
                    <TextBlock Grid.Column="1" Text="Sentory 종료" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </StackPanel>
    </Border>
</Window>
