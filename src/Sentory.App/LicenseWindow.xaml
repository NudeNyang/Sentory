<Window x:Class="Sentory.App.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.LicenseTitle}"
        Width="680"
        Height="720"
        MinWidth="560"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        ShowInTaskbar="False"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E9E4DC" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F3EC" />
        <SolidColorBrush x:Key="TextBrush" Color="#292722" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6D6861" />
        <SolidColorBrush x:Key="LineBrush" Color="#CEC7BC" />
        <SolidColorBrush x:Key="AccentBrush" Color="#756655" />
    </Window.Resources>
    <Grid Margin="30,26,30,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{DynamicResource Loc.LicenseHeading}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock Margin="0,6,0,0"
                       Text="{DynamicResource Loc.LicenseDescription}"
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>
        <Border Grid.Row="2"
                Padding="22"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          FocusVisualStyle="{x:Null}">
                <TextBlock x:Name="LicenseText"
                           FontFamily="Consolas"
                           FontSize="11.5"
                           LineHeight="19"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
