<Window x:Class="Sentory.App.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sentory.App"
        Title="Sentory"
        Width="1180"
        Height="780"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#E9E4DC" />
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#F2EEE7" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F3EC" />
        <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="#DED8CF" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#E4DED5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#756655" />
        <SolidColorBrush x:Key="FavoriteBrush" Color="#B1842F" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="#F7F4EE" />
        <SolidColorBrush x:Key="TextBrush" Color="#292722" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6D6861" />
        <SolidColorBrush x:Key="SoftTextBrush" Color="#89827A" />
        <SolidColorBrush x:Key="LineBrush" Color="#CEC7BC" />
        <SolidColorBrush x:Key="CopyButtonBackgroundBrush" Color="#EDF3EEE7" />
        <SolidColorBrush x:Key="CopyButtonHoverBrush" Color="#FAF7F1" />
        <SolidColorBrush x:Key="CopyButtonBorderBrush" Color="#C8C0B5" />
        <SolidColorBrush x:Key="CardHoverBorderBrush" Color="#9A8976" />
        <SolidColorBrush x:Key="SelectionTintBrush" Color="#1A756655" />
        <SolidColorBrush x:Key="SelectionBorderBrush" Color="#66756655" />
        <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#E2DDD5" />
        <SolidColorBrush x:Key="StatusTextBrush" Color="#5E5952" />
        <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#E8E2D7" />
        <SolidColorBrush x:Key="NoticeBorderBrush" Color="#B8AA97" />
        <SolidColorBrush x:Key="SkeletonBrush" Color="#D9D3CA" />
        <SolidColorBrush x:Key="EmptyIconBackgroundBrush" Color="#DCE3F1" />
        <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#292722" />
        <SolidColorBrush x:Key="ToastTextBrush" Color="#F2EEE7" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B85A52" />
        <SolidColorBrush x:Key="DiscordDetectionBrush" Color="#8B765A" />

        <Style x:Key="FilterButtonStyle" TargetType="ToggleButton">
            <Setter Property="Foreground"
                    Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="10,7,10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter Property="FontWeight"
                                        Value="SemiBold" />
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97"
                                                        ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Root"
                                        Property="RenderTransformOrigin"
                                        Value="0.5,0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CopyButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background"
                    Value="{DynamicResource CopyButtonBackgroundBrush}" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource CopyButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource CopyButtonHoverBrush}" />
                                <Setter TargetName="Root"
                                        Property="BorderBrush"
                                        Value="{DynamicResource CardHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94"
                                                        ScaleY="0.94" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Root"
                                        Property="RenderTransformOrigin"
                                        Value="0.5,0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InlineFavoriteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource StatusBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92"
                                                        ScaleY="0.92" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Root"
                                        Property="RenderTransformOrigin"
                                        Value="0.5,0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource StatusBackgroundBrush}" />
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97"
                                                        ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Root"
                                        Property="RenderTransformOrigin"
                                        Value="0.5,0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuOptionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground"
                    Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource StatusBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root"
                                        Property="Opacity"
                                        Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BannerActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Root"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="7">
                            <ContentPresenter VerticalAlignment="Center"
                                              ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource StatusBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource LineBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackgroundBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="30,22,30,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Sentory"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{DynamicResource Loc.Tagline}"
                               FontSize="13"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <StackPanel Margin="0,9,0,0"
                                Orientation="Horizontal"
                                AutomationProperties.Name="{DynamicResource Loc.DiscordDetection}">
                        <Ellipse Width="8" Height="8"
                                 Margin="0,0,7,0"
                                 Fill="{DynamicResource DiscordDetectionBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc.DiscordDetection}"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="DiscordDetectionStatusText"
                                   Margin="8,0,0,0"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource DiscordDetectionBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Border x:Name="RuntimeIssueChip"
                            Margin="0,7,0,0"
                            Padding="8,4,5,4"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource NoticeBackgroundBrush}"
                            BorderBrush="{DynamicResource NoticeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="11"
                                       Foreground="{DynamicResource DangerBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="RuntimeIssueText"
                                       Margin="6,0,5,0"
                                       MaxWidth="430"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Button Width="24"
                                    Height="24"
                                    Padding="0"
                                    Content="&#xE711;"
                                    FontFamily="Segoe Fluent Icons"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    ToolTip="{DynamicResource Loc.CloseNotification}"
                                    Click="DismissRuntimeIssueButton_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="0"
                        Grid.Column="1"
                        Height="42"
                        Background="{DynamicResource InputBackgroundBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="&#xE721;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="15"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox"
                                     Margin="0,0,12,0"
                                     Padding="0"
                                     AutomationProperties.Name="{DynamicResource Loc.Search}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"
                                     FontSize="13"
                                     Foreground="{DynamicResource TextBrush}"
                                     TextChanged="SearchBox_TextChanged" />
                            <TextBlock IsHitTestVisible="False"
                                       Text="{DynamicResource Loc.SearchPlaceholder}"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource SoftTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility"
                                                Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}"
                                                         Value="0">
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Button x:Name="ThemeButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="10,3,0,3"
                        Style="{StaticResource CopyButtonStyle}"
                        AutomationProperties.Name="{DynamicResource Loc.SwitchToDark}"
                        ToolTip="{DynamicResource Loc.SwitchToDark}"
                        Click="ThemeButton_Click">
                    <TextBlock x:Name="ThemeIcon"
                               Text="&#xE708;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="15" />
                </Button>

                <Grid Grid.Row="1"
                      Grid.ColumnSpan="3"
                      Margin="0,20,0,0">
                    <StackPanel HorizontalAlignment="Left"
                                Orientation="Horizontal">
                        <ToggleButton x:Name="AllFilterButton"
                                      AutomationProperties.AutomationId="FilterAll"
                                      Content="{DynamicResource Loc.All}"
                                      IsChecked="True"
                                      Style="{StaticResource FilterButtonStyle}"
                                      Checked="FilterButton_Checked"
                                      Unchecked="FilterButton_Unchecked" />
                        <ToggleButton x:Name="UrlFilterButton"
                                      AutomationProperties.AutomationId="FilterUrl"
                                      Margin="4,0,0,0"
                                      Content="{DynamicResource Loc.Links}"
                                      Style="{StaticResource FilterButtonStyle}"
                                      Checked="FilterButton_Checked"
                                      Unchecked="FilterButton_Unchecked" />
                        <ToggleButton x:Name="ImageFilterButton"
                                      AutomationProperties.AutomationId="FilterImage"
                                      Margin="4,0,0,0"
                                      Content="{DynamicResource Loc.Photos}"
                                      Style="{StaticResource FilterButtonStyle}"
                                      Checked="FilterButton_Checked"
                                      Unchecked="FilterButton_Unchecked" />
                        <ToggleButton x:Name="FavoriteFilterButton"
                                      AutomationProperties.AutomationId="FilterFavorite"
                                      Margin="4,0,0,0"
                                      Style="{StaticResource FilterButtonStyle}"
                                      Checked="FilterButton_Checked"
                                      Unchecked="FilterButton_Unchecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE735;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="12"
                                           Foreground="{DynamicResource FavoriteBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Margin="6,0,0,0"
                                           Text="{DynamicResource Loc.Favorites}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="IntegratedFilterButton"
                                AutomationProperties.AutomationId="IntegratedFilterButton"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="IntegratedFilterButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71C;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock
                                           Margin="7,0,0,0"
                                           Text="{DynamicResource Loc.Filter}"
                                           VerticalAlignment="Center" />
                                <Border x:Name="FilterCountBadge"
                                        MinWidth="18"
                                        Height="18"
                                        Margin="6,0,0,0"
                                        Padding="5,0"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="9"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="FilterCountText"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Margin="7,0,0,0"
                                           Text="&#xE70D;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="10"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SortButton"
                                AutomationProperties.AutomationId="SortButton"
                                Margin="4,0,0,0"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="SortButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8CB;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="SortButtonText"
                                           Margin="7,0,8,0"
                                           Text="{DynamicResource Loc.SortNewest}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="10"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SelectModeButton"
                                AutomationProperties.AutomationId="SelectModeButton"
                                Margin="4,0,0,0"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="{DynamicResource Loc.Select}"
                                Click="SelectModeButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE762;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="SelectModeButtonText"
                                           Margin="7,0,0,0"
                                           Text="{DynamicResource Loc.Select}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DataManagementButton"
                                AutomationProperties.AutomationId="DataManagementButton"
                                Margin="4,0,0,0"
                                Style="{StaticResource ToolbarButtonStyle}"
                                ToolTip="{DynamicResource Loc.Settings}"
                                Click="DataManagementButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Margin="7,0,0,0"
                                           Text="{DynamicResource Loc.Settings}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Popup x:Name="IntegratedFilterPopup"
                           PlacementTarget="{Binding ElementName=IntegratedFilterButton}"
                           Placement="Bottom"
                           VerticalOffset="6"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           StaysOpen="False">
                        <Border Width="236"
                                Padding="10"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <Grid Margin="4,0,4,5">
                                    <TextBlock Text="{DynamicResource Loc.Filter}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="FilterResetButton"
                                            HorizontalAlignment="Right"
                                            Height="28"
                                            Padding="8,0"
                                            Content="{DynamicResource Loc.Reset}"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Click="FilterResetButton_Click" />
                                </Grid>

                                <TextBlock Margin="11,6,0,3"
                                           Text="{DynamicResource Loc.Messenger}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SoftTextBrush}" />
                                <StackPanel x:Name="SourceOptionsPanel" />

                                <Border Height="1"
                                        Margin="8,8,8,7"
                                        Background="{DynamicResource LineBrush}" />

                                <TextBlock Margin="11,0,0,3"
                                           Text="{DynamicResource Loc.Period}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SoftTextBrush}" />
                                <Button x:Name="DateAllButton"
                                        Content="{DynamicResource Loc.AllPeriod}"
                                        Tag="All"
                                        Style="{StaticResource MenuOptionButtonStyle}"
                                        Click="DateOptionButton_Click" />
                                <Button x:Name="DateTodayButton"
                                        Content="{DynamicResource Loc.Today}"
                                        Tag="Today"
                                        Style="{StaticResource MenuOptionButtonStyle}"
                                        Click="DateOptionButton_Click" />
                                <Button x:Name="Date7DaysButton"
                                        Content="{DynamicResource Loc.Last7Days}"
                                        Tag="Last7Days"
                                        Style="{StaticResource MenuOptionButtonStyle}"
                                        Click="DateOptionButton_Click" />
                                <Button x:Name="Date30DaysButton"
                                        Content="{DynamicResource Loc.Last30Days}"
                                        Tag="Last30Days"
                                        Style="{StaticResource MenuOptionButtonStyle}"
                                        Click="DateOptionButton_Click" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Popup x:Name="SortPopup"
                           PlacementTarget="{Binding ElementName=SortButton}"
                           Placement="Bottom"
                           VerticalOffset="6"
                           AllowsTransparency="True"
                           PopupAnimation="Fade"
                           StaysOpen="False">
                        <Border Width="184"
                                Padding="6"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <Button x:Name="SortNewestButton"
                                        Content="{DynamicResource Loc.SortNewest}"
                                        Tag="Newest"
                                        Style="{StaticResource MenuOptionButtonStyle}"
                                        Click="SortOptionButton_Click" />
                                <Button x:Name="SortOldestButton"
                                        Content="{DynamicResource Loc.SortOldest}"
                                        Tag="Oldest"
                                        Style="{StaticResource MenuOptionButtonStyle}"
                                        Click="SortOptionButton_Click" />
                                <Button x:Name="SortMostCapturedButton"
                                        Content="{DynamicResource Loc.SortMostCaptured}"
                                        Tag="MostCaptured"
                                        Style="{StaticResource MenuOptionButtonStyle}"
                                        Click="SortOptionButton_Click" />
                                <Button x:Name="SortMostCopiedButton"
                                        Content="{DynamicResource Loc.SortMostCopied}"
                                        Tag="MostCopied"
                                        Style="{StaticResource MenuOptionButtonStyle}"
                                        Click="SortOptionButton_Click" />
                                <Button x:Name="SortRecentlyCopiedButton"
                                        Content="{DynamicResource Loc.SortRecentlyCopied}"
                                        Tag="RecentlyCopied"
                                        Style="{StaticResource MenuOptionButtonStyle}"
                                        Click="SortOptionButton_Click" />
                                <Button x:Name="SortNameButton"
                                        Content="{DynamicResource Loc.SortName}"
                                        Tag="Name"
                                        Style="{StaticResource MenuOptionButtonStyle}"
                                        Click="SortOptionButton_Click" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="DiscordConnectionBanner"
                Grid.Row="1"
                Margin="30,14,30,0"
                Padding="15,12"
                Background="{DynamicResource NoticeBackgroundBrush}"
                BorderBrush="{DynamicResource NoticeBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32"
                        Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="9">
                    <TextBlock Text="&#xE777;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="14"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Loc.DiscordPrepareHeading}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Margin="0,3,0,0"
                               Text="{DynamicResource Loc.DiscordPrepareDescription}"
                               FontSize="10.5"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <Button Grid.Column="2"
                        Margin="14,0,0,0"
                        Content="{DynamicResource Loc.Later}"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="DiscordLaterButton_Click" />
                <Button Grid.Column="3"
                        Margin="6,0,0,0"
                        Content="{DynamicResource Loc.ApplyNow}"
                        Style="{StaticResource BannerActionButtonStyle}"
                        Click="DiscordRepairButton_Click" />
            </Grid>
        </Border>

        <Grid x:Name="GallerySelectionSurface"
              Grid.Row="2"
              ClipToBounds="True"
              PreviewMouseLeftButtonDown="GallerySelectionSurface_PreviewMouseLeftButtonDown"
              PreviewMouseMove="GallerySelectionSurface_PreviewMouseMove"
              PreviewMouseLeftButtonUp="GallerySelectionSurface_PreviewMouseLeftButtonUp"
              LostMouseCapture="GallerySelectionSurface_LostMouseCapture"
              MouseLeave="GallerySelectionSurface_MouseLeave">
            <ScrollViewer x:Name="GalleryScrollViewer"
                          Padding="14,20,14,28"
                          FocusVisualStyle="{x:Null}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden"
                          ScrollChanged="GalleryScrollViewer_ScrollChanged">
                <ItemsControl x:Name="GalleryItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:CenteredWrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card"
                                    Width="252"
                                    Height="320"
                                    Margin="8"
                                    AutomationProperties.Name="{Binding AutomationName}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Cursor="Hand"
                                    ContextMenuOpening="Card_ContextMenuOpening"
                                    MouseLeftButtonUp="Card_MouseLeftButtonUp">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="{Binding FavoriteMenuLabel}"
                                                  Click="FavoriteMenuItem_Click" />
                                        <Separator />
                                        <MenuItem Header="{DynamicResource Loc.Copy}"
                                                  Click="CopyMenuItem_Click" />
                                        <MenuItem Header="{DynamicResource Loc.OpenOriginal}"
                                                  Click="OpenMenuItem_Click" />
                                        <Separator />
                                        <MenuItem Header="{DynamicResource Loc.Delete}"
                                                  Foreground="{DynamicResource DangerBrush}"
                                                  Click="DeleteMenuItem_Click" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="170" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Border x:Name="CardSelectionOverlay"
                                            Grid.RowSpan="2"
                                            Margin="1"
                                            Background="{DynamicResource SelectionTintBrush}"
                                            BorderBrush="{DynamicResource SelectionBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="15"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed" />

                                    <Border Grid.Row="0"
                                            Margin="10,10,10,0"
                                            Background="{DynamicResource SurfaceSecondaryBrush}"
                                            CornerRadius="12"
                                            Cursor="Hand"
                                            ToolTip="{DynamicResource Loc.OpenPreview}"
                                            Tag="{Binding}"
                                            MouseLeftButtonUp="Artwork_MouseLeftButtonUp">
                                        <Grid>
                                            <Grid x:Name="UrlArtwork">
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <Border Width="54"
                                                            Height="54"
                                                            Background="{DynamicResource SurfaceBrush}"
                                                            BorderBrush="{DynamicResource LineBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="14">
                                                        <Grid>
                                                            <TextBlock x:Name="UrlInitial"
                                                                       Text="{Binding Initial}"
                                                                       FontSize="23"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                            <Image x:Name="UrlSiteIcon"
                                                                   Width="34"
                                                                   Height="34"
                                                                   Source="{Binding SiteIcon}"
                                                                   Stretch="Uniform"
                                                                   Visibility="Collapsed" />
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Margin="0,11,0,0"
                                                               Text="{Binding Domain}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               MaxWidth="180"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>

                                            <Border x:Name="ThumbnailImage"
                                                    Margin="{Binding ThumbnailMargin}"
                                                    Visibility="Collapsed">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Thumbnail}"
                                                                Stretch="{Binding ThumbnailStretch}"
                                                                AlignmentX="Center"
                                                                AlignmentY="Center" />
                                                </Border.Background>
                                            </Border>

                                            <Border x:Name="CollectionBadge"
                                                    Margin="12"
                                                    Padding="9,5"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Background="{DynamicResource SurfaceBrush}"
                                                    BorderBrush="{DynamicResource LineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    IsHitTestVisible="False"
                                                    Visibility="Collapsed">
                                                <TextBlock Text="{Binding CollectionBadgeText}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Button x:Name="CardCopyButton"
                                            Grid.Row="0"
                                            Margin="0,20,20,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource CopyButtonStyle}"
                                            ToolTip="{DynamicResource Loc.CopyToClipboard}"
                                            AutomationProperties.Name="{DynamicResource Loc.Copy}"
                                            Tag="{Binding}"
                                            Click="CopyButton_Click">
                                        <TextBlock Text="&#xE8C8;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="15" />
                                    </Button>

                                    <Button x:Name="SelectionButton"
                                            Grid.Row="0"
                                            Width="34"
                                            Height="34"
                                            Margin="20,20,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            AutomationProperties.Name="{Binding SelectionToolTip}"
                                            Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource AccentBrush}"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            Tag="{Binding}"
                                            Visibility="Collapsed"
                                            Click="SelectionButton_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="17">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock x:Name="SelectionIconText"
                                                   Text="{Binding SelectionIcon}"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Button>

                                    <Grid Grid.Row="1" Margin="16,13,16,15">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Image x:Name="CardSiteIcon"
                                                       Width="13"
                                                       Height="13"
                                                       Margin="0,0,5,0"
                                                       Source="{Binding SiteIcon}"
                                                       Stretch="Uniform"
                                                       Visibility="Collapsed" />
                                                <TextBlock Text="{Binding TypeLabel}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            </StackPanel>
                                            <TextBlock HorizontalAlignment="Right"
                                                       Text="{Binding DateLabel}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SoftTextBrush}" />
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,9,0,0"
                                                   Text="{Binding Title}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2"
                                                   Margin="0,5,0,0"
                                                   Text="{Binding Subtitle}"
                                                   FontSize="12"
                                                   LineHeight="17"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap" />
                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Height="28"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Padding="8,0"
                                                    Background="{DynamicResource StatusBackgroundBrush}"
                                                    CornerRadius="8">
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           VerticalAlignment="Center"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource StatusTextBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Margin="0,0,7,0"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding CopyUsageLabel}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource SoftTextBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasBeenCopied}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button x:Name="CardFavoriteButton"
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource InlineFavoriteButtonStyle}"
                                                    ToolTip="{Binding FavoriteToolTip}"
                                                    AutomationProperties.Name="{Binding FavoriteToolTip}"
                                                    Tag="{Binding}"
                                                    Click="FavoriteButton_Click">
                                                <Button.RenderTransform>
                                                    <TranslateTransform X="6" />
                                                </Button.RenderTransform>
                                                <TextBlock Text="{Binding FavoriteIcon}"
                                                           FontFamily="Segoe Fluent Icons"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource FavoriteBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Opacity"
                                                                    Value="0.72" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Item.IsFavorite}"
                                                                             Value="True">
                                                                    <Setter Property="Opacity"
                                                                            Value="1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasPrimaryArtwork}"
                                             Value="True">
                                    <Setter TargetName="UrlArtwork"
                                            Property="Visibility"
                                            Value="Collapsed" />
                                    <Setter TargetName="ThumbnailImage"
                                            Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasSiteIcon}"
                                             Value="True">
                                    <Setter TargetName="UrlInitial"
                                            Property="Visibility"
                                            Value="Collapsed" />
                                    <Setter TargetName="UrlSiteIcon"
                                            Property="Visibility"
                                            Value="Visible" />
                                    <Setter TargetName="CardSiteIcon"
                                            Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasCollectionBadge}"
                                             Value="True">
                                    <Setter TargetName="CollectionBadge"
                                            Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelectionMode}"
                                             Value="True">
                                    <Setter TargetName="SelectionButton"
                                            Property="Visibility"
                                            Value="Visible" />
                                    <Setter TargetName="CardCopyButton"
                                            Property="Visibility"
                                            Value="Collapsed" />
                                    <Setter TargetName="CardFavoriteButton"
                                            Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}"
                                             Value="True">
                                    <Setter TargetName="CardSelectionOverlay"
                                            Property="Visibility"
                                            Value="Visible" />
                                    <Setter TargetName="SelectionButton"
                                            Property="Background"
                                            Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="SelectionIconText"
                                            Property="Foreground"
                                            Value="{DynamicResource AccentTextBrush}" />
                                </DataTrigger>
                                <Trigger SourceName="Card"
                                         Property="IsMouseOver"
                                         Value="True">
                                    <Setter TargetName="Card"
                                            Property="BorderBrush"
                                            Value="{DynamicResource CardHoverBorderBrush}" />
                                    <Setter TargetName="Card"
                                            Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="-2" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Canvas Panel.ZIndex="10"
                    IsHitTestVisible="False">
                <Border x:Name="DragSelectionRectangle"
                        Width="0"
                        Height="0"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1.5"
                        CornerRadius="4"
                        Visibility="Collapsed">
                    <Border Margin="1"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="3"
                            Opacity="0.2" />
                </Border>
            </Canvas>

            <Border x:Name="GalleryScrollIndicator"
                    Panel.ZIndex="40"
                    Width="10"
                    Margin="0,0,1,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    Cursor="Arrow"
                    IsHitTestVisible="False"
                    Opacity="0"
                    SnapsToDevicePixels="True"
                    Visibility="Collapsed"
                    MouseEnter="GalleryScrollIndicator_MouseEnter"
                    MouseLeave="GalleryScrollIndicator_MouseLeave"
                    PreviewMouseLeftButtonDown="GalleryScrollIndicator_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="GalleryScrollIndicator_PreviewMouseMove"
                    PreviewMouseLeftButtonUp="GalleryScrollIndicator_PreviewMouseLeftButtonUp"
                    PreviewMouseWheel="GalleryScrollIndicator_PreviewMouseWheel"
                    LostMouseCapture="GalleryScrollIndicator_LostMouseCapture"
                    SizeChanged="GalleryScrollIndicator_SizeChanged">
                <Grid ClipToBounds="True">
                    <Border x:Name="GalleryScrollIndicatorThumb"
                            Width="3"
                            Height="32"
                            Margin="0,0,3,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="3"
                            Opacity="0.46"
                            SnapsToDevicePixels="True">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="GalleryScrollIndicatorThumbTransform" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="SelectionBar"
                    Panel.ZIndex="20"
                    Margin="0,0,0,22"
                    Padding="14,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SelectedCountText"
                               Margin="2,0,12,0"
                               Text="{DynamicResource Loc.SelectedCountFormat}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />
                    <Button Margin="0,0,4,0"
                            Content="{DynamicResource Loc.SelectVisible}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="SelectVisibleItemsButton_Click" />
                    <Button Margin="0,0,4,0"
                            Content="{DynamicResource Loc.ClearSelection}"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="ClearSelectionButton_Click" />
                    <Button x:Name="DeleteSelectedButton"
                            Content="{DynamicResource Loc.DeleteSelected}"
                            Background="{DynamicResource DangerBrush}"
                            Style="{StaticResource BannerActionButtonStyle}"
                            Click="DeleteSelectedButton_Click" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="LoadingPanel"
                        Width="720"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,56,0,0">
                <TextBlock Text="{DynamicResource Loc.LoadingLibrary}"
                           FontSize="13"
                           Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Center" />
                <UniformGrid Margin="0,22,0,0" Columns="3">
                    <Border Height="260"
                            Margin="8"
                            Background="{DynamicResource SkeletonBrush}"
                            CornerRadius="16" />
                    <Border Height="260"
                            Margin="8"
                            Background="{DynamicResource SkeletonBrush}"
                            CornerRadius="16" />
                    <Border Height="260"
                            Margin="8"
                            Background="{DynamicResource SkeletonBrush}"
                            CornerRadius="16" />
                </UniformGrid>
            </StackPanel>

            <StackPanel x:Name="EmptyPanel"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="64"
                        Height="64"
                        Background="{DynamicResource EmptyIconBackgroundBrush}"
                        CornerRadius="18">
                    <TextBlock Text="&#xE8B7;"
                               FontFamily="Segoe Fluent Icons"
                               FontSize="25"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="EmptyTitleText"
                           Margin="0,18,0,0"
                           Text="{DynamicResource Loc.NoItems}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyDescriptionText"
                           Margin="0,7,0,0"
                           Text="{DynamicResource Loc.NoItemsDescription}"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="ErrorPanel"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Loc.LoadFailed}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="ErrorText"
                           Margin="0,7,0,0"
                           MaxWidth="460"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Button Margin="0,18,0,0"
                        Padding="16,8"
                        Content="{DynamicResource Loc.Retry}"
                        Click="RetryButton_Click" />
            </StackPanel>

            <Border x:Name="FeedbackToast"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,28,26"
                    Padding="14,10"
                    Background="{DynamicResource ToastBackgroundBrush}"
                    CornerRadius="10">
                <TextBlock x:Name="FeedbackText"
                           FontSize="12"
                           Foreground="{DynamicResource ToastTextBrush}" />
            </Border>
        </Grid>
    </Grid>
</Window>
